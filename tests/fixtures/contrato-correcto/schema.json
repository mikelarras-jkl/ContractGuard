{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CorrectOrder",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed"]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" }
        },
        "required": ["sku"]
      }
    }
  },
  "required": ["id", "email"]
}
