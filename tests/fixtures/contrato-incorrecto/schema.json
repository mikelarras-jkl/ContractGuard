{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "IncorrectOrder",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed"]
    },
    "lines": {
      "type": "array",
      "required": ["sku"],
      "items": [
        {
          "type": "object",
          "properties": {
            "sku": { "type": "string" }
          }
        }
      ],
      "properties": {
        "items": {
          "type": "object"
        }
      }
    },
    "email": {
      "type": "string"
    }
  },
  "required": ["id", "email"]
}
